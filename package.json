{
  "name": "@webship-js/penpot-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for Penpot, the open-source design and prototyping platform, with webship-js: the session, the dashboard and its projects and files, teams and their members, the design workspace, comments, the view mode and its shared links, exports, libraries, and the mail.",
  "main": "tests/step-definitions/penpot-session.steps.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "penpot",
    "design",
    "prototyping",
    "design-tool",
    "teams",
    "comments",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "gherkin",
    "testing",
    "e2e"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/penpot-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/penpot-steps/issues"
  },
  "homepage": "https://github.com/webship/penpot-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
